// Configuración de Cloudflare Workers: sirve la web React ya compilada (web/dist).
// En Cloudflare → Settings → Build, poner como "Build command":
//   cd web && npm ci && npm run build
// El JSON lo regenera cada día GitHub Actions; cada push dispara un nuevo despliegue.
{
  "name": "1hack-theagilemonkeys",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "single-page-application"
  }
}

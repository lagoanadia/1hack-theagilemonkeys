// Configuración de Cloudflare Workers.
//  - La web React compilada (web/dist) se sirve como archivos estáticos.
//  - /api/* lo atiende worker/index.js, que guarda los datos en D1 (base de datos SQLite gratuita).
// En Cloudflare → Settings → Build:
//   Build command:  cd web && npm ci && npm run build
//   Deploy command: npx wrangler deploy
// Secretos (Settings → Variables and Secrets):
//   GOOGLE_CLIENT_ID = ID de cliente OAuth de Google (login del equipo)
//   EMAILS_EQUIPO    = emails autorizados separados por comas, o un dominio "@reforesta.es"
{
  "name": "1hack-theagilemonkeys",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "radar-reforesta",
      "database_id": "65cd74d3-a2f9-4050-908c-128e89bfa921"
    }
  ]
}
